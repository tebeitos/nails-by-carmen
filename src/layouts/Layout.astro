---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nails & Bridal by Carmen · Manicura nupcial en Avilés, Asturias',
  description = 'Especialista en manicura nupcial en Avilés. Carmen Valdés lleva doce años haciendo uñas y se especializó en novias. Lista de espera abierta para 2025 y 2026.',
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: 'Nails & Bridal by Carmen',
  description,
  telephone: '+34 984 12 34 56',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Avilés',
    addressRegion: 'Asturias',
    addressCountry: 'ES',
  },
  sameAs: ['https://www.instagram.com/nailsbycarmen'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #f7f3ee;
    --bg-secondary: #ede8e0;
    --accent: #8a9e7a;
    --text: #6b5b4e;
    --whatsapp: #25d366;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg-primary);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  .serif {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    line-height: 1.15;
    margin: 0;
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    padding: 1rem 2rem;
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .btn:hover {
    background: #7c9068;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(138, 158, 122, 0.35);
  }

  .btn-lg {
    padding: 1.2rem 2.6rem;
    font-size: 1.05rem;
  }
</style>
